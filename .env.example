# Environment Variables
NODE_ENV=production

# Server Configuration
PORT=3000

# Password for the web interface.
# Required on Railway (the app stays locked without it). Optional for local use.
NAS_PASSWORD=choose-a-long-password

# Where uploaded files are stored (point at a Railway Volume, e.g. /data)
# UPLOAD_DIR=/data

# Storage Configuration (choose one)
# For local storage (ephemeral on Railway):
USE_S3=false

# For S3 storage (persistent on Railway):
# USE_S3=true
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
