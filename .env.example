# Password for the web interface.
# Required on Railway (the app stays locked without it). Optional for local use.
NAS_PASSWORD=choose-a-long-password

# Folder to store files in (server) or to share (local).
# Defaults to the Railway volume if one is attached, otherwise ./uploads
# UPLOAD_DIR=/data

# Local mode: serve a folder on this PC in place and allow backup to a server.
# The Windows launcher (Start Local NAS.bat) sets these for you.
# NAS_MODE=local
# NAS_NAME=Lucid's PC
